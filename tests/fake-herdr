#!/bin/bash
# テスト用の herdr の代役。$FAKE_DIR/agents.tsv（端末ID・ペインID・エージェント名）を一覧として返し、
# 送られた名前を $FAKE_DIR/shown/ペインID に覚える。
case "$1 $2" in
  "agent list")
    [ -f "$FAKE_DIR/fail" ] && exit 1
    [ -f "$FAKE_DIR/broken" ] && { echo '{"error": "x"}'; exit 0; }
    while IFS=$'\t' read -r term pane agent; do
      [ -n "$term" ] || continue
      shown=$(cat "$FAKE_DIR/shown/$pane" 2>/dev/null)
      jq -n --arg t "$term" --arg p "$pane" --arg a "$agent" --arg s "$shown" \
        '{terminal_id: $t, pane_id: $p, agent: $a} + (if $s == "" then {} else {display_agent: $s} end)'
    done <"$FAKE_DIR/agents.tsv" | jq -s '{result: {agents: .}}'
    ;;
  "pane report-metadata")
    pane=$3
    shift 3
    while [ $# -gt 0 ]; do
      case "$1" in
        --display-agent) echo "$2" >"$FAKE_DIR/shown/$pane"; echo "set $pane $2" >>"$FAKE_DIR/calls"; shift ;;
        --clear-display-agent) rm -f "$FAKE_DIR/shown/$pane"; echo "clear $pane" >>"$FAKE_DIR/calls" ;;
        --source) shift ;;
      esac
      shift
    done
    ;;
esac
